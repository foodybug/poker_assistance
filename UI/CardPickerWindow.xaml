<Window x:Class="PokerAssistant.UI.CardPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="카드 수동 선택기" Height="420" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#181B26"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#3B82F6" BorderThickness="1"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="카드 선택 (52장 카드 덱)" FontSize="18" FontWeight="Bold" Foreground="#F7FAFC"/>
            <Button Content="✕" Width="30" Height="30" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Background="#2D3748" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand"
                    Click="Close_Click"/>
        </DockPanel>

        <!-- Cards Grid 4 rows (Spades, Hearts, Diamonds, Clubs) x 13 columns (2..A) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="CardGrid" Rows="4" Columns="13" Margin="0,4"/>
        </ScrollViewer>

        <!-- Selected Status & Confirm -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="SelectedSummaryText" Text="선택된 카드: -" FontSize="14" Foreground="#A0AEC0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="선택 완료" Background="#3182CE" Foreground="White" FontWeight="Bold"
                        Padding="16,8" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"
                        Click="Confirm_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
