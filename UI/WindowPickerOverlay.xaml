<Window x:Class="PokerAssistant.UI.WindowPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="포커 창 선택"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#30000000"
        WindowState="Maximized"
        Topmost="True"
        Cursor="Cross"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Grid>
        <Border Background="#D00F172A" CornerRadius="12" Padding="24,16" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                BorderBrush="#38BDF8" BorderThickness="1.5">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎯 지정할 포커 게임 창(넷마블/윈조이)을 마우스로 클릭하세요!" 
                           FontSize="18" FontWeight="ExtraBold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                <TextBlock Text="클릭한 위치의 창이 자동으로 분석 대상으로 지정됩니다. (취소: ESC)" 
                           FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
