<Window x:Class="PokerAssistant.UI.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="포커 영역 캘리브레이션 (화면 감지 영역 설정)" Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Instructions -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="🎯 포커 테이블 영역 캘리브레이션" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="넷마블/윈조이 창에 맞추어 [내 카드], [보드 카드], [내 턴 게이지/타이머] 영역을 미세 조정합니다."
                               FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📸 화면 다시 캡처" Background="#334155" Foreground="#F1F5F9" Padding="12,6" Margin="4,0" BorderThickness="0" Cursor="Hand" Click="RefreshCapture_Click"/>
                    <Button Content="넷마블 기본값" Background="#2563EB" Foreground="White" Padding="12,6" Margin="4,0" BorderThickness="0" Cursor="Hand" Click="NetmarblePreset_Click"/>
                    <Button Content="윈조이 기본값" Background="#7C3AED" Foreground="White" Padding="12,6" Margin="4,0" BorderThickness="0" Cursor="Hand" Click="WinjoyPreset_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body: Left Preview, Right Sliders & Crop Previews -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Screen View Canvas -->
            <Border Grid.Column="0" Background="#020617" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True" Margin="0,0,12,0">
                <Canvas x:Name="PreviewCanvas" SizeChanged="PreviewCanvas_SizeChanged">
                    <Image x:Name="CapturedImage" Stretch="Fill"/>
                    <!-- Overlay Bounding Boxes -->
                    <Rectangle x:Name="HeroBox" Stroke="#38BDF8" StrokeThickness="2" Fill="#2038BDF8"/>
                    <Rectangle x:Name="BoardBox" Stroke="#4ADE80" StrokeThickness="2" Fill="#204ADE80"/>
                    <Rectangle x:Name="TimerBox" Stroke="#F87171" StrokeThickness="2" Fill="#20F87171"/>
                </Canvas>
            </Border>

            <!-- Right Controls & Mini Previews -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Hero Region -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🟦 내 카드 영역 (Hero)" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="X 위치" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,2"/>
                            <Slider x:Name="HeroXSlider" Minimum="0" Maximum="1" ValueChanged="Sliders_ValueChanged"/>
                            <TextBlock Text="Y 위치" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,2"/>
                            <Slider x:Name="HeroYSlider" Minimum="0" Maximum="1" ValueChanged="Sliders_ValueChanged"/>
                            <TextBlock Text="너비 / 높이" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="HeroWSlider" Grid.Column="0" Minimum="0.05" Maximum="0.5" ValueChanged="Sliders_ValueChanged" Margin="0,0,4,0"/>
                                <Slider x:Name="HeroHSlider" Grid.Column="1" Minimum="0.05" Maximum="0.4" ValueChanged="Sliders_ValueChanged" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Board Region -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🟩 보드 카드 영역 (Community)" FontWeight="Bold" Foreground="#4ADE80"/>
                            <TextBlock Text="X / Y 위치" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,2"/>
                            <Slider x:Name="BoardXSlider" Minimum="0" Maximum="1" ValueChanged="Sliders_ValueChanged"/>
                            <Slider x:Name="BoardYSlider" Minimum="0" Maximum="1" ValueChanged="Sliders_ValueChanged"/>
                            <TextBlock Text="너비 / 높이" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BoardWSlider" Grid.Column="0" Minimum="0.1" Maximum="0.7" ValueChanged="Sliders_ValueChanged" Margin="0,0,4,0"/>
                                <Slider x:Name="BoardHSlider" Grid.Column="1" Minimum="0.05" Maximum="0.4" ValueChanged="Sliders_ValueChanged" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Timer / Gauge Region -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🟥 내 턴 타이머/게이지 감지 영역" FontWeight="Bold" Foreground="#F87171"/>
                            <TextBlock Text="내 턴에 나타나는 시간 게이지 바 또는 버튼 영역" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="X / Y 위치" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,2"/>
                            <Slider x:Name="TimerXSlider" Minimum="0" Maximum="1" ValueChanged="Sliders_ValueChanged"/>
                            <Slider x:Name="TimerYSlider" Minimum="0" Maximum="1" ValueChanged="Sliders_ValueChanged"/>
                            <TextBlock Text="너비 / 높이" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="TimerWSlider" Grid.Column="0" Minimum="0.05" Maximum="0.6" ValueChanged="Sliders_ValueChanged" Margin="0,0,4,0"/>
                                <Slider x:Name="TimerHSlider" Grid.Column="1" Minimum="0.02" Maximum="0.3" ValueChanged="Sliders_ValueChanged" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="💡 노란색/주황색 타이머 게이지가 차오르는 위치에 빨간 상자를 맞춰주세요." VerticalAlignment="Center" Foreground="#CBD5E1"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Background="#475569" Foreground="White" Padding="16,8" Margin="4,0" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
                    <Button Content="💾 설정 저장 및 적용" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="20,8" Margin="4,0" BorderThickness="0" Cursor="Hand" Click="Save_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
